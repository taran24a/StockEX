FROM node:22-alpine AS build
WORKDIR /workspace

COPY package.json package-lock.json ./
COPY tsconfig.base.json ./
COPY shared/package.json shared/package.json
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN npm ci

COPY shared shared
COPY server server
RUN npm run build --workspace @tradewise/shared \
    && npm run build --workspace @tradewise/server

FROM node:22-alpine AS runtime
WORKDIR /workspace
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY shared/package.json shared/package.json
COPY server/package.json server/package.json
COPY client/package.json client/package.json
RUN npm ci --omit=dev

COPY --chown=node:node --from=build /workspace/shared/dist shared/dist
COPY --chown=node:node --from=build /workspace/server/dist server/dist
COPY --chown=node:node server/openapi.yaml server/openapi.yaml

USER node
EXPOSE 3000 4000
CMD ["node", "server/dist/index.js"]
