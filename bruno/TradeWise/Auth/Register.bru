meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
}

body:json {
  {
    "email": "bruno-user@tradewise.dev",
    "displayName": "Bruno Trader",
    "password": "BrunoTrader@1234"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
  bru.setVar("userId", res.body.user.id);
}
