{
  "name": "@tradewise/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:feed": "tsx watch src/feed/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build --workspace @tradewise/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @tradewise/shared",
    "test": "vitest run src",
    "migrate": "node --import tsx src/db/migrate.ts",
    "migrate:up": "node --import tsx src/db/migrate.ts up",
    "migrate:down": "node --import tsx src/db/migrate.ts down",
    "seed": "node --import tsx src/db/seed.ts",
    "candles:generate": "node --import tsx src/db/generate-candles.ts",
    "candles:import": "node --import tsx src/db/import-candles.ts",
    "repl": "node --import tsx src/repl.ts",
    "demo:modules": "node src/demos/module-format-demo.mjs"
  },
  "dependencies": {
    "@tradewise/shared": "1.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.22.0",
    "xss": "^1.0.16"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.0.5"
  }
}
